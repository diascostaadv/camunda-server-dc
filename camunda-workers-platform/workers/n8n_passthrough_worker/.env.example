# Camunda Configuration
CAMUNDA_URL=https://camunda-diascosta.up.railway.app/engine-rest
CAMUNDA_USERNAME=demo
CAMUNDA_PASSWORD=demo

# n8n Webhook (ÚNICO ponto de entrada)
N8N_WEBHOOK_URL=https://n8n-diascosta.up.railway.app/webhook/camunda-tasks
N8N_WEBHOOK_URL_TEST=https://n8n-diascosta.up.railway.app/webhook-test/camunda-tasks

# Worker Configuration
WORKER_ID=n8n-passthrough-worker
MAX_TASKS=100000
LOCK_DURATION=60000
ASYNC_RESPONSE_TIMEOUT=30000
RETRIES=3
RETRY_TIMEOUT=5000
SLEEP_SECONDS=10

# Topics (OPCIONAL - deixe vazio para modo AUTO)
# CAMUNDA_TOPICS=buscar_publicacoes,tratar_publicacao,nova_publicacao,classificar_publicacao

# Logging
LOG_LEVEL=INFO

# Metrics
METRICS_PORT=8000

# Gateway (não usado neste worker)
GATEWAY_ENABLED=false
